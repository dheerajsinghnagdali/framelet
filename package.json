{
  "name": "framelet",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/demo",
    "docs": "npm run dev --workspace apps/docs",
    "docs:build": "npm run build --workspace apps/docs",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@vitest/coverage-v8": "5.1.1",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "oxfmt --write",
      "oxlint"
    ],
    "*.{json,md,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
